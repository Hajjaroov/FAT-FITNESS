# Local Postgres environment template.
# Copy to infrastructure/.env (gitignored) before running `docker compose up` from this directory.
# Must match the values already baked into the existing named volume
# (infrastructure_fitness_postgres_data_pg18) — Postgres only applies
# POSTGRES_USER/POSTGRES_PASSWORD on first init of an empty data directory.

FATFITNESS_DB_USERNAME=fitness_user
FATFITNESS_DB_PASSWORD=fitness_password
