# Local backend environment template.
# Copy values into backend/fatfitness-api/.env for local bootRun.
# The real .env file is ignored by Git.

FATFITNESS_DB_USERNAME=fitness_user
FATFITNESS_DB_PASSWORD=fitness_password

# Required (no committed default): JWT signing secret, >= 32 chars.
# Startup fails without it. Use a throwaway value locally, a real secret in prod.
FATFITNESS_JWT_SECRET=

# Refresh cookie Secure flag defaults to TRUE. Local dev runs over plain
# http://localhost, so explicitly opt out here; leave unset in production.
FATFITNESS_REFRESH_COOKIE_SECURE=false

FATFITNESS_OWNER_EMAIL=
FATFITNESS_OWNER_DISPLAY_NAME=
FATFITNESS_OWNER_COUNTRY_REGION_CODE=
FATFITNESS_OWNER_PASSWORD=

RESEND_API_KEY=
MAIL_FROM=noreply@fatfitness.net
APP_BASE_URL=http://localhost:3000

# Optional overrides (safe defaults are used when unset).
# FATFITNESS_CORS_ALLOWED_ORIGINS=http://localhost:3000
